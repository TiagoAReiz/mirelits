# Copie para .env.local e preencha os valores (nunca commite .env.local)

# Base de dados (Supabase Postgres via Prisma)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Supabase Storage (upload de imagens, bucket "mirelits")
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js (NextAuth v5) com Google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-mails autorizados no /admin (separados por vírgula)
ADMIN_EMAIL=

# Formulário de contato (Resend)
RESEND_API_KEY=
RESEND_FROM=
CONTACT_EMAIL=
